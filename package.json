{
  "name": "tornet",
  "private": true,
  "type": "module",
  "description": "Hissimulering i pixelgrafik – åtta hissar i en skyskrapa",
  "scripts": {
    "start": "python3 serve.py",
    "test": "node tests/run.mjs",
    "golden": "node tests/run.mjs --update-golden",
    "bench": "node tests/bench.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test",
    "quick": "npm run typecheck && node tests/run.mjs --quick",
    "league": "node tests/league.mjs",
    "lang": "node tools/lang.mjs"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "typescript": "^7.0.2"
  }
}
